<xml xmlns="http://www.w3.org/1999/xhtml">
  <variables>
    <variable type="" id="tradeCount">0</variable>
    <variable type="" id="hourStart">0</variable>
    <variable type="" id="Stake">2</variable>
  </variables>

  <!-- 1. TRADE PARAMETERS (mandatory & pre-filled) -->
  <block type="trade" id="trade" x="0" y="0">
    <field name="MARKET_LIST">synthetic_index</field>
    <field name="SUBMARKET_LIST">random_index</field>
    <field name="SYMBOL_LIST">R_100</field>
    <field name="TRADETYPECAT_LIST">callput</field>
    <field name="TRADETYPE_LIST">risefall</field>
    <field name="TYPE_LIST">both</field>
    <field name="CANDLEINTERVAL_LIST">60</field>
    <field name="TIME_MACHINE_ENABLED">FALSE</field>
    <field name="RESTARTONERROR">TRUE</field>

    <!-- Stake is fixed at $2 -->
    <statement name="SUBMARKET">
      <block type="tradeOptions" id="tradeOpts">
        <field name="DURATIONTYPE_LIST">m</field>
        <field name="CURRENCY_LIST">USD</field>
        <value name="DURATION">
          <block type="math_number">
            <field name="NUM">5</field>
          </block>
        </value>
        <value name="AMOUNT">
          <block type="variables_get">
            <field name="VAR" id="Stake">Stake</field>
          </block>
        </value>
      </block>
    </statement>
  </block>

  <!-- 2. RESET 5-TRADE COUNTER EVERY HOUR -->
  <block type="controls_if" id="resetHour" x="0" y="120">
    <value name="IF0">
      <block type="logic_compare">
        <field name="OP">GT</field>
        <value name="A">
          <block type="epoch">
            <field name="TIMESTAMP">hour</field>
          </block>
        </value>
        <value name="B">
          <block type="variables_get">
            <field name="VAR" id="hourStart">hourStart</field>
          </block>
        </value>
      </block>
    </value>
    <statement name="DO0">
      <block type="variables_set">
        <field name="VAR" id="tradeCount">tradeCount</field>
        <value name="VALUE">
          <block type="math_number">
            <field name="NUM">0</field>
          </block>
        </value>
      </block>
      <block type="variables_set">
        <field name="VAR" id="hourStart">hourStart</field>
        <value name="VALUE">
          <block type="epoch">
            <field name="TIMESTAMP">hour</field>
          </block>
        </value>
      </block>
    </statement>
  </block>

  <!-- 3. ONLY 5 TRADES PER HOUR -->
  <block type="controls_if" id="checkMax" x="0" y="240">
    <value name="IF0">
      <block type="logic_compare">
        <field name="OP">LT</field>
        <value name="A">
          <block type="variables_get">
            <field name="VAR" id="tradeCount">tradeCount</field>
          </block>
        </value>
        <value name="B">
          <block type="math_number">
            <field name="NUM">5</field>
          </block>
        </value>
      </block>
    </value>
    <statement name="DO0">
      <!-- 4. PURCHASE CONDITION: STOCHASTIC -->
      <block type="before_purchase" id="strategy">
        <statement name="BEFOREPURCHASE_STACK">
          <block type="purchase" id="purchase">
            <field name="PURCHASE_LIST">CALLPUT</field>
            <value name="CONDITION">
              <block type="logic_operation">
                <field name="OP">OR</field>
                <value name="A">
                  <block type="logic_compare">
                    <field name="OP">GT</field>
                    <value name="A">
                      <block type="indicators_stochastic">
                        <field name="INDICATOR">stoch</field>
                        <value name="INPUT">
                          <block type="text">R_100</block>
                        </value>
                        <value name="K">
                          <block type="math_number">
                            <field name="NUM">14</field>
                          </block>
                        </value>
                        <value name="D">
                          <block type="math_number">
                            <field name="NUM">3</field>
                          </block>
                        </value>
                        <value name="SMOOTH">
                          <block type="math_number">
                            <field name="NUM">3</field>
                          </block>
                        </value>
                        <value name="INDEX">0</value>
                      </block>
                    </value>
                    <value name="B">
                      <block type="math_number">
                        <field name="NUM">80</field>
                      </block>
                    </value>
                  </block>
                </value>
                <value name="B">
                  <block type="logic_compare">
                    <field name="OP">LT</field>
                    <value name="A">
                      <block type="indicators_stochastic">
                        <field name="INDICATOR">stoch</field>
                        <value name="INPUT">
                          <block type="text">R_100</block>
                        </value>
                        <value name="K">
                          <block type="math_number">
                            <field name="NUM">14</field>
                          </block>
                        </value>
                        <value name="D">
                          <block type="math_number">
                            <field name="NUM">3</field>
                          </block>
                        </value>
                        <value name="SMOOTH">
                          <block type="math_number">
                            <field name="NUM">3</field>
                          </block>
                        </value>
                        <value name="INDEX">0</value>
                      </block>
                    </value>
                    <value name="B">
                      <block type="math_number">
                        <field name="NUM">20</field>
                      </block>
                    </value>
                  </block>
                </value>
              </block>
            </value>
            <value name="TYPE_LIST">
              <block type="controls_if">
                <value name="IF0">
                  <block type="logic_compare">
                    <field name="OP">GT</field>
                    <value name="A">
                      <block type="indicators_stochastic">
                        <field name="INDICATOR">stoch</field>
                        <value name="INPUT">
                          <block type="text">R_100</block>
                        </value>
                        <value name="K">
                          <block type="math_number">
                            <field name="NUM">14</field>
                          </block>
                        </value>
                        <value name="D">
                          <block type="math_number">
                            <field name="NUM">3</field>
                          </block>
                        </value>
                        <value name="SMOOTH">
                          <block type="math_number">
                            <field name="NUM">3</field>
                          </block>
                        </value>
                        <value name="INDEX">0</value>
                      </block>
                    </value>
                    <value name="B">
                      <block type="math_number">
                        <field name="NUM">80</field>
                      </block>
                    </value>
                  </block>
                </value>
                <statement name="DO0">
                  <block type="trade_definition_tradeoptions">
                    <field name="TYPE_LIST">fall</field>
                  </block>
                </statement>
                <statement name="ELSE">
                  <block type="trade_definition_tradeoptions">
                    <field name="TYPE_LIST">rise</field>
                  </block>
                </statement>
              </block>
            </value>
            <next>
              <block type="variables_set">
                <field name="VAR" id="tradeCount">tradeCount</field>
                <value name="VALUE">
                  <block type="math_arithmetic">
                    <field name="OP">ADD</field>
                    <value name="A">
                      <block type="variables_get">
                        <field name="VAR" id="tradeCount">tradeCount</field>
                      </block>
                    </value>
                    <value name="B">
                      <block type="math_number">
                        <field name="NUM">1</field>
                      </block>
                    </value>
                  </block>
                </value>
              </block>
            </next>
          </block>
        </statement>
      </block>
    </statement>
  </block>

  <!-- 5. AFTER-PURCHASE LOGGING (optional) -->
  <block type="after_purchase" id="finish">
    <statement name="AFTERPURCHASE_STACK">
      <block type="notify">
        <field name="NOTIFICATION_TYPE">info</field>
        <field name="NOTIFICATION_SOUND">silent</field>
        <value name="MESSAGE">
          <block type="text_join">
            <mutation items="2"></mutation>
            <value name="ADD0">
              <block type="text">
                <field name="TEXT">Trade done. Hour count = </field>
              </block>
            </value>
            <value name="ADD1">
              <block type="variables_get">
                <field name="VAR" id="tradeCount">tradeCount</field>
              </block>
            </value>
          </block>
        </value>
      </block>
    </statement>
  </block>
</xml>
