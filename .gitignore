*.swp
*.swo

# Editors and IDEs
.vscode/
.idea/

# OS specific
.DS_Store
Thumbs.db

# Coverage and testing
coverage/
htmlcov/
.coverage
.mypy_cache/
.pytest_cache/
.gradle/
```